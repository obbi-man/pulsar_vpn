# Local demo (API without Supabase): CS_LOCAL_DEMO=1
# Login: admin@pulsar.local / demo-admin  (legacy admin@customshield.local also ok)
CS_LOCAL_DEMO=1

# Supabase (required for production panel; leave empty in local demo)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: override VPN listen port written at provision time (default 51820)
# CS_VPN_PORT=51820

# Billing (Pro tariff)
# mock = no secrets; UI/API checkout + confirm upgrades plan for 30 days
# stripe = requires STRIPE_SECRET_KEY (Checkout Session wiring is stubbed until keys exist)
CS_BILLING_MODE=mock
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
